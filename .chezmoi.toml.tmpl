# Generated by `chezmoi init`; lives at ~/.config/chezmoi/chezmoi.toml.
sourceDir = {{ .chezmoi.workingTree | quote }}
[data]
    machine = {{ .chezmoi.hostname | quote }}
{{- if eq .chezmoi.hostname "magi" }}
    # herdr houses: one named session and systemd unit each (herdr@<house>).
    houses = ["autocut", "shop-flows", "print-farm", "shops", "clients", "dev-marketing", "ai-team-plugin", "workflow", "conduit", "brain", "infra"]
{{- else }}
    houses = []
{{- end }}
