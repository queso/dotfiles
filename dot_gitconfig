[user]
  name = Josh Owens
  email = joshua.owens@gmail.com
[color]
  branch = auto
  diff = auto
  interactive = auto
  status = auto
[core]
	editor = vim
  excludesfile = ~/.gitignore_global
[github]
  user = queso
[heroku]
[alias]
  st = status
  ci = commit
  br = branch
  co = checkout
  df = diff -b --color-words
  dfw = diff -w
  pend = cherry -v origin/master
  lg = log --graph --pretty=format:'%Cred%H%Creset -%Cblue %an  %Creset %Cgreen(%cr)%Creset %s'
  graph = log --graph --oneline --decorate=short --branches='*'
  fl = log --pretty=full --stat
[push]
	default = simple
[pull]
	ff = only
[init]
	defaultBranch = main
[url "git@github.com:"]
	insteadOf = https://github.com/~

# Per-box settings (signing keys, hook paths, credential helpers) live here.
# Untracked, outside the repo. Later includes win, so this overrides the above.
[include]
	path = ~/.gitconfig.local
