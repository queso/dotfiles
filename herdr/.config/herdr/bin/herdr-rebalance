#!/usr/bin/env python3
"""Rebalance the current herdr tab so every pane gets equal area: each split's
ratio becomes leaves(first) / leaves(all). Bound to prefix+= in config.toml.

Usage: herdr-rebalance [--tab TAB_ID]
Target: --tab, else $HERDR_PANE_ID, else the UI-focused pane.
"""
import json, os, socket, subprocess, sys

SOCK = os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser("~/.config/herdr/herdr.sock")


def call(method, params):
    c = socket.socket(socket.AF_UNIX)
    c.settimeout(5)
    c.connect(SOCK)
    c.sendall((json.dumps({"id": f"rebalance:{method}", "method": method, "params": params}) + "\n").encode())
    buf = b""
    while not buf.endswith(b"\n"):
        chunk = c.recv(65536)
        if not chunk:
            break
        buf += chunk
    c.close()
    resp = json.loads(buf)
    if "error" in resp:
        raise SystemExit(f"herdr {method}: {resp['error']}")
    return resp["result"]


def leaves(node):
    if node["type"] == "pane":
        return 1
    return leaves(node["first"]) + leaves(node["second"])


def plan(node, path):
    """Yield (path, ratio) for every split: the first child's share of the leaves."""
    if node["type"] != "split":
        return
    yield path, leaves(node["first"]) / leaves(node)
    yield from plan(node["first"], path + [False])
    yield from plan(node["second"], path + [True])


def main(argv):
    tab = argv[argv.index("--tab") + 1] if "--tab" in argv else None
    if tab:
        target = {"tab_id": tab}
    elif os.environ.get("HERDR_PANE_ID"):
        target = {"pane_id": os.environ["HERDR_PANE_ID"]}
    else:
        out = subprocess.run(["herdr", "pane", "current"], capture_output=True, text=True, check=True).stdout
        target = {"pane_id": json.loads(out)["result"]["pane"]["pane_id"]}
    root = call("layout.export", target)["layout"]["root"]
    changes = list(plan(root, []))
    for path, ratio in changes:
        call("layout.set_split_ratio", {**target, "path": path, "ratio": ratio})
    print(f"rebalanced {target}: {len(changes)} split(s)")


if __name__ == "__main__":
    main(sys.argv[1:])
