{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "model": "fable",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/screenshot-relay.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/handoff/scripts/session-start.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/chezmoi-drift.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x $HOME/.local/bin/herdmates ] && $HOME/.local/bin/herdmates hook TeammateIdle || true",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x $HOME/.local/bin/herdmates ] && $HOME/.local/bin/herdmates hook TaskCreated || true",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x $HOME/.local/bin/herdmates ] && $HOME/.local/bin/herdmates hook TaskCompleted || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "ai-code-audit@ai-code-audit": true,
    "ai-team@the-ai-team-plugin": true,
    "devtrack@devtrack": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ai-code-audit": {
      "source": {
        "source": "directory",
        "path": "/home/josh/Code/TheAITeam/ai-code-audit"
      }
    },
    "devtrack": {
      "source": {
        "source": "github",
        "repo": "queso/DevTrack"
      }
    }
  },
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true
}
