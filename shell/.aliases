alias gca="git commit --amend --author='Josh Owens <joshua.owens@gmail.com>'"

# The old tmux flow, kept until the tmux sessions on magi are retired.
# Usage: magi-tmux ls | magi-tmux [session] [dir]
magi-tmux() {
  if [[ "${1:-}" == "ls" ]]; then
    ssh magi.theowens.casa "tmux list-sessions 2>/dev/null || echo 'No sessions running'"
    return
  fi

  local session="${1:-default}"
  local dir="${2:-}"
  local watcher_pid=""

  # Start sidebar status watcher if running inside cmux
  if [[ -n "${CMUX_WORKSPACE_ID:-}" ]]; then
    ~/.claude-magi-watcher.sh "$CMUX_WORKSPACE_ID" 3 &
    watcher_pid=$!
    disown "$watcher_pid" 2>/dev/null
  fi

  local tmux_cmd="tmux new-session -As $session"
  if [[ -n "$dir" ]]; then
    # Replace local home path with $HOME so it expands on the remote side
    dir="${dir/#$HOME/\$HOME}"
    tmux_cmd="tmux new-session -As $session -c $dir"
  fi

  ssh -t magi.theowens.casa "$tmux_cmd"

  # Clean up watcher when SSH exits
  if [[ -n "$watcher_pid" ]]; then
    kill "$watcher_pid" 2>/dev/null || true
  fi
}

# magi through herdr. magi runs one herdr server per "house" (a named session);
# rooms are workspaces inside a house. Houses (9/12): autocut shop-flows
# print-farm shops clients dev-marketing ai-team-plugin workflow conduit brain infra.
#   magi ls                     houses, each with its rooms and agent status
#   magi <house>                attach the herdr TUI to that house on magi (detach: ctrl+j q)
#   magi <house> <room> [dir]   focus the room in that house, creating it at dir if missing, then attach
# Listing and creating go over ssh with a login shell (brew shellenv); attach is
# `herdr --remote`, which only works with the bare TUI launch. The local herdr
# keeps the magi machine profile disabled so the local sidebar stays local.
magi() {
  local remote=(ssh -o BatchMode=yes magi.local)
  case "${1:-}" in
    ls)
      "${remote[@]}" 'zsh -lc "for h in \$(herdr session list --json | jq -r \".[] | select(.status==\\\"running\\\") | .name\"); do [ \"\$h\" = default ] && continue; printf \"%-15s\" \"\$h\"; herdr --session \"\$h\" workspace list | jq -r \"[.result.workspaces[] | .label + \\\"(\\\" + .agent_status + \\\")\\\"] | join(\\\"  \\\")\"; done"'
      ;;
    "")
      echo "usage: magi ls | magi <house> | magi <house> <room> [dir]" >&2; return 1
      ;;
    *)
      local house="$1" room="${2:-}" dir="${3:-}" id
      if [[ -n "$room" ]]; then
        id=$("${remote[@]}" "zsh -lc \"herdr --session $house workspace list\"" \
          | jq -r --arg l "$room" '.result.workspaces[] | select(.label==$l) | .workspace_id' | head -1)
        if [[ -z "$id" ]]; then
          dir="${dir/#$HOME/\$HOME}"
          id=$("${remote[@]}" "zsh -lc \"herdr --session $house workspace create --label '$room' ${dir:+--cwd $dir}\"" \
            | jq -r '.result.workspace.workspace_id')
          [[ -n "$id" && "$id" != null ]] || { echo "magi: could not create room '$room' in house '$house'" >&2; return 1; }
        fi
        "${remote[@]}" "zsh -lc \"herdr --session $house workspace focus $id\"" >/dev/null
      fi
      herdr --remote magi.local --session "$house"
      ;;
  esac
}

# Encrypt/decrypt CBT therapy files with age
cbt_lock() {
  local dir="$HOME/Code/Brain/Health/mental"
  local key="$HOME/.age/brain-key.txt"
  for f in "$dir"/*.md; do
    [ -f "$f" ] || continue
    age -R "$key" -o "${f}.age" "$f" && rm "$f"
  done
  echo "CBT files locked."
}

cbt_unlock() {
  local dir="$HOME/Code/Brain/Health/mental"
  local key="$HOME/.age/brain-key.txt"
  for f in "$dir"/*.md.age; do
    [ -f "$f" ] || continue
    age -d -i "$key" -o "${f%.age}" "$f" && rm "$f"
  done
  echo "CBT files unlocked."
}

# Claude Code with bypass permissions (you only live once)
alias cyolo='claude --dangerously-skip-permissions --teammate-mode tmux'

# Preview markdown in a tmux split pane with glow
mdread() { tmux split-window -h "glow -p '$1'"; }

# Preview code in a tmux split pane with syntax highlighting
coderead() { tmux split-window -h "batcat --paging=always '$1'"; }
# herdr: inside a herdr pane, launch claude through the herdmates teammux shim so
# agent-team teammates open as real herdr panes. Outside herdr this is a no-op.
# Added 2026-09-12 during the herdr local test.
claude() {
  if [[ -n "$HERDR_PANE_ID" && -x "$HOME/.local/bin/herdmates" ]]; then
    # Lead pane share of the tab for split-pane teams (patched shim; Claude Code's own default is 30).
    export TEAMMUX_LEAD_WIDTH="${TEAMMUX_LEAD_WIDTH:-50}"
    "$HOME/.local/bin/herdmates" teammux-launch "$@"
  else
    command claude "$@"
  fi
}

# Copy to Mac clipboard over SSH via OSC 52 (pipe or file)
rcopy() {
  if [ $# -eq 1 ] && [ -f "$1" ]; then
    printf '\033]52;c;%s\a' "$(base64 -w 0 < "$1")"
  else
    printf '\033]52;c;%s\a' "$(base64 -w 0 < /dev/stdin)"
  fi
}
