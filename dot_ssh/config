Host macbook
  HostName 10.0.1.2
  User josh
  IdentityFile ~/.ssh/screenshot_relay
  IdentitiesOnly yes
  ControlMaster auto
  ControlPath /tmp/ssh-screenshot-%r@%h:%p
  ControlPersist 4h

# Cache the key in the agent on first use, so one passphrase prompt per boot
# covers every later git/ssh call, including non-interactive ones.
Host *
  AddKeysToAgent yes
